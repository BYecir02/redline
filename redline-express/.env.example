# Port du serveur Express
PORT=3001

# Auth : secret de signature des JWT. OBLIGATOIRE et >= 16 caractères en production.
# Générer par ex. avec :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Base de données Postgres (historique des scans / analytics).
#
# --- Option A : Docker local (docker-compose.yml fourni) ---
# DATABASE_URL et DIRECT_URL sont identiques en local.
DATABASE_URL="postgresql://redline:redline@localhost:55432/redline?schema=public"
DIRECT_URL="postgresql://redline:redline@localhost:55432/redline?schema=public"
#
# --- Option B : Supabase (démo / déploiement) ---
# Remplacer par les URLs du projet Supabase (Settings > Database) :
#   DATABASE_URL = connexion "pooler" (port 6543, ?pgbouncer=true)
#   DIRECT_URL   = connexion "direct"  (port 5432), utilisée pour les migrations
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Fournisseur IA (utilisé plus tard par engine/aiClient.ts — non branché pour l'instant)
# ANTHROPIC_API_KEY=sk-ant-...

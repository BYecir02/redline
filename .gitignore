# ============================================================
#  Redline - .gitignore (monorepo : React + Node + Symfony)
# ============================================================

# ---- Dépendances ----
node_modules/
**/node_modules/
/vendor/
**/vendor/

# ---- Build / sorties de compilation ----
dist/
build/
**/dist/
**/build/
.vite/
*.tsbuildinfo

# ---- Environnement & secrets (NE JAMAIS committer) ----
# Secrets du moteur Node (JWT_SECRET, identifiants BDD)
/redline-backend/.env
# Fichiers d'environnement locaux (secrets) - partout, tous projets
.env.local
.env.*.local
!.env.example
# NB : redline-symfony/.env est volontairement versionné (config par défaut,
#      sans secret) ; les vrais secrets Symfony vont dans .env.local (ignoré).

# ---- Symfony ----
/redline-symfony/var/
/redline-symfony/vendor/
/redline-symfony/.env.local
/redline-symfony/config/jwt/*.pem
/redline-symfony/public/bundles/

# ---- Tests & couverture ----
coverage/
.phpunit.result.cache
.phpunit.cache/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- IDE / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Documents de travail internes (non versionnés) ----
symfony.md
